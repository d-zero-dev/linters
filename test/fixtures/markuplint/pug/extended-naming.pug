.c-carousel
	.splide
		.c-carousel__inner
			.splide__track
				.splide__list
					.splide__slide
						img(src="path/to/image01.jpg" alt="image01")
					.splide__slide
						img(src="path/to/image02.jpg" alt="image02")
					.splide__slide
						img(src="path/to/image03.jpg" alt="image03")
			.splide__arrows.c-carousel__arrows
		.c-carousel__control
			button.c-carousel__control-prev(aria-label="Previous")
			ul.c-carousel__pagination.splide__pagination: li
			button.c-carousel__control-next(aria-label="Next")
