.c-carousel
	.splide
		.c-carousel__inner
			.splide__track
				.splide__list
					.splide__slide
						img(alt="image01" src="path/to/image01.jpg")
					.splide__slide
						img(alt="image02" src="path/to/image02.jpg")
					.splide__slide
						img(alt="image03" src="path/to/image03.jpg")
			.splide__arrows.c-carousel__arrows
		.c-carousel__control
			button.c-carousel__control-prev(aria-label="Previous")
			ul.c-carousel__pagination.splide__pagination: li
			button.c-carousel__control-next(aria-label="Next")
